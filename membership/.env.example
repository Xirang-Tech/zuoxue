HOST=127.0.0.1
# local / production; integration is reserved for scripts/run-local-integration.mjs.
DEPLOYMENT_ENV=local
PORT=5088
PUBLIC_ORIGIN=http://127.0.0.1:5088
DATABASE_URL=postgres://localhost:5432/zuoxue_membership
# Provision a dedicated relying party in Identity Admin; never reuse another product's token.
IDENTITY_SERVICE_URL=
IDENTITY_SERVICE_RP_KEY=zuoxue-membership
IDENTITY_SERVICE_TOKEN=
IDENTITY_PUBLIC_ORIGIN=https://auth.zuoxue.com
# Each product needs a separate random token. JSON is server-only, never returned to browsers.
PRODUCT_CLIENTS_JSON={}
PRODUCT_ADAPTERS_JSON={}
ADMIN_TOKEN=
EXPERIMENT_VERSION=union-v1
EXPERIMENT_SALT=
EXPERIMENT_ENABLED=false
SALES_ENABLED=false
# Server-only account overrides are forbidden outside integration/staging.
STAGING_TEST_ACCOUNTS_JSON={}
CATALOG_FILE=./config/catalog.json
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_PLATFORM_SERIAL=
WECHAT_PLATFORM_PUBLIC_KEY_FILE=
WECHAT_API_V3_KEY=
